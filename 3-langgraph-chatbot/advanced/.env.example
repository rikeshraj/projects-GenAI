# No API keys required — this project runs entirely on free, local resources.

OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

DENSE_K=6
BM25_K=6
FINAL_K=4

# LangGraph checkpointer thread id — reuse the same value across runs to
# resume a previous conversation (memory is persisted in checkpoints.sqlite)
THREAD_ID=terminal-session
