# No API keys required — this project runs entirely on free, local resources.

# Ollama model to use (must be pulled first: `ollama pull qwen2.5:0.5b`)
OLLAMA_MODEL=qwen2.5:0.5b
# Ollama server URL (default when running `ollama serve` locally)
OLLAMA_BASE_URL=http://localhost:11434

# Free local HuggingFace embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
